{
  "name": "tripdar",
  "version": "0.1.0",
  "private": true,
  "description": "Tripdar - A reflective, comparative experience system",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.0.1",
    "@vercel/og": "^0.9.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "resend": "^6.12.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "8.65.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "dev": "next dev",
    "dev:vite": "vite",
    "photo:pipeline": "node scripts/photo-pipeline/cli.mjs",
    "build": "prisma generate && NODE_ENV=production next build",
    "build:vite": "tsc && vite build",
    "lint": "eslint",
    "start": "next start",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "staff-review:prepare-invite-batch": "node --env-file-if-exists=.env.local node_modules/vite-node/vite-node.mjs scripts/prepare-staff-review-invite-batch.mts --",
    "staff-review:record-invite-batch-approval": "node --env-file-if-exists=.env.local node_modules/vite-node/vite-node.mjs scripts/record-staff-review-invite-batch-approval.mts --",
    "check:myco-strain-drift": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-myco-strain-slug-drift.mts",
    "report:tmt-reviewer-status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/tmt-reviewer-status.mts"
  }
}
