generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Note: SQLite does not support enums. Enum validation is enforced in application logic.
// Valid values are documented here for reference:
//
// DoseCategory: MICRODOSE, LOW, MODERATE, HIGH
// ExperienceScale: MICRO, MACRO
// ReferenceFrame: BASELINE, WITHIN_STRAIN, CROSS_STRAIN
// Direction: MORE, LESS, SAME, NOT_NOTICED

enum PhotoJobProcessingMode {
  catalog_safe
  premium
}

enum PhotoJobStatus {
  uploaded
  analyzing
  processing
  validating
  needs_review
  approved
  rejected
  failed
}

model Signal {
  // Immutability intent:
  // - Signals are append-only.
  // - Signals MUST NOT be updated or deleted (enforce in application logic; not encoded as schema constraints here).
  // - Aggregation is computed from signals and MUST NOT be stored on this table.

  id String @id // Unique identifier (provided by application; no helper defaults)

  // Context
  strainId     String
  doseCategory String // MICRODOSE, LOW, MODERATE, HIGH (validated in app)
  scale        String // MICRO, MACRO (validated in app)

  // Dimension (must be one of the 28 experiential dimensions; enforced in application logic)
  dimensionId String

  // Reference + conditional comparison fields (enforce conditional rules in application logic)
  referenceFrame     String // BASELINE, WITHIN_STRAIN, CROSS_STRAIN (validated in app)
  comparisonDose     String? // REQUIRED ONLY when referenceFrame = WITHIN_STRAIN; MUST be null otherwise
  comparisonStrainId String? // REQUIRED ONLY when referenceFrame = CROSS_STRAIN; MUST be null otherwise

  // Observation
  direction String // MORE, LESS, SAME, NOT_NOTICED (validated in app)

  // Grouping / anonymity
  sessionId String // Anonymous session identifier
  reportId  String // Groups signals from one submission

  // Creation timestamp (set by application at insert-time; no additional timestamps are stored)
  createdAt DateTime
}

// ============================================================================
// Community Ratings & Reviews
// ============================================================================

model StrainRating {
  id          String   @id @default(cuid())
  strainSlug  String
  rating      Int // 1-5 stars
  sessionHash String // Anonymous session identifier
  partnerId   String // Partner who facilitated this rating
  createdAt   DateTime @default(now())

  @@index([strainSlug])
  @@index([partnerId])
}

model StrainReview {
  id          String    @id @default(cuid())
  strainSlug  String
  rating      Int // 1-5 stars
  title       String?
  body        String
  sessionHash String // Anonymous session identifier
  partnerId   String // Partner who facilitated this review
  status      String    @default("pending") // pending, approved, rejected
  createdAt   DateTime  @default(now())
  moderatedAt DateTime?
  moderatedBy String?

  @@index([strainSlug, status])
  @@index([partnerId])
  @@index([status])
}

// ============================================================================
// Trip Reports
// ============================================================================

model TripReport {
  id          String @id @default(cuid())
  strainSlug  String
  sessionHash String // Anonymous session identifier
  partnerId   String // Partner who facilitated this report

  // Dosing info
  doseAmount   String // e.g., "2.5g", "1 stem"
  doseCategory String // MICRODOSE, LOW, MODERATE, HIGH, HEROIC

  // Experience context
  setting   String // e.g., "nature", "home", "ceremony"
  intention String? // What they hoped to achieve

  // The report itself
  title         String
  body          String // Full trip narrative
  duration      String? // e.g., "4-6 hours"
  peakIntensity Int? // 1-10 scale

  // Moderation
  status      String    @default("pending") // pending, approved, rejected
  createdAt   DateTime  @default(now())
  moderatedAt DateTime?
  moderatedBy String?

  @@index([strainSlug, status])
  @@index([partnerId])
  @@index([status])
}

// ============================================================================
// Analytics
// ============================================================================

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String // page_view, quiz_complete, search, rating, report
  entitySlug  String? // Strain slug or other entity reference
  partnerId   String // Partner who generated this event
  sessionHash String // Anonymous session identifier
  metadata    String? // JSON string for additional event data
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([partnerId, createdAt])
  @@index([entitySlug, createdAt])
}

model AnalyticsSummary {
  id              String   @id @default(cuid())
  period          String // daily, weekly, monthly
  periodStart     DateTime
  strainSlug      String   @default("") // empty string for overall summary
  views           Int      @default(0)
  searches        Int      @default(0)
  quizCompletions Int      @default(0)
  ratings         Int      @default(0)
  reviews         Int      @default(0)
  reports         Int      @default(0)
  avgRating       Float?

  @@unique([period, periodStart, strainSlug])
  @@index([period, periodStart])
}

// ============================================================================
// Community Confidence (Feature 1)
// ============================================================================

model StrainConfidence {
  id                 String   @id @default(cuid())
  strainSlug         String   @unique
  baseConfidence     Int // From strain data (0-100)
  triedCount         Int      @default(0)
  ratingCount        Int      @default(0)
  reportCount        Int      @default(0)
  avgRating          Float?
  computedConfidence Int      @default(0) // Weighted combination (0-100)
  verifiedTier       String   @default("emerging") // emerging, developing, established, verified
  lastUpdated        DateTime @default(now()) @updatedAt

  @@index([verifiedTier])
}

// ============================================================================
// Dosage Curves (Feature 2)
// ============================================================================

model DoseCurveData {
  id               String   @id @default(cuid())
  strainSlug       String
  doseCategory     String // MICRODOSE, LOW, MODERATE, HIGH, HEROIC
  reportCount      Int      @default(0)
  avgPeakIntensity Float?
  minPeakIntensity Int?
  maxPeakIntensity Int?
  lastUpdated      DateTime @default(now()) @updatedAt

  @@unique([strainSlug, doseCategory])
  @@index([strainSlug])
}

// ============================================================================
// Setting Insights (Feature 4)
// ============================================================================

model SettingInsight {
  id                  String   @id @default(cuid())
  strainSlug          String
  setting             String // nature, home, ceremony, social, solo, etc.
  reportCount         Int      @default(0)
  avgIntensity        Float?
  recommendationScore Float    @default(0)
  lastUpdated         DateTime @default(now()) @updatedAt

  @@unique([strainSlug, setting])
  @@index([strainSlug, recommendationScore(sort: Desc)])
}

// ============================================================================
// User Profiles & Recommendations (Feature 3)
// ============================================================================

model UserStrainProfile {
  id          String   @id @default(cuid())
  sessionHash String
  strainSlug  String
  tried       Boolean  @default(true)
  rating      Int? // 1-5 if rated
  createdAt   DateTime @default(now())

  @@unique([sessionHash, strainSlug])
  @@index([sessionHash])
  @@index([strainSlug])
}

model StrainCorrelation {
  id                String   @id @default(cuid())
  strainA           String
  strainB           String
  coOccurrenceCount Int      @default(0)
  avgRatingA        Float?
  avgRatingB        Float?
  similarityScore   Float    @default(0) // Computed correlation
  lastUpdated       DateTime @default(now()) @updatedAt

  @@unique([strainA, strainB])
  @@index([strainA, similarityScore(sort: Desc)])
  @@index([strainB, similarityScore(sort: Desc)])
}

// ============================================================================
// Recommendation Engine
// ============================================================================

model RecommendationSession {
  id              String   @id @default(cuid())
  sessionToken    String   @unique
  experienceLevel String // new, few_times, experienced, very_experienced
  inputPath       String // mood_tiles, sliders, guided_quiz
  intentVector    String // JSON string: { clarity_cognition: 0.6, ... }
  rawInput        String // JSON string: original user selections
  partnerId       String
  createdAt       DateTime @default(now())

  results         RecommendationResult[]
  dosingGuides    DosingGuideToken[]
  mycoChatSession MycoChatSession?
  mycoResults     MycoRecommendationResult[]

  @@index([partnerId, createdAt])
  @@index([sessionToken])
}

// Product-first recommendation results (Myco customer flow). Strain-keyed
// RecommendationResult stays as-is for the WordPress strain engine.
model MycoRecommendationResult {
  id            String   @id @default(cuid())
  sessionId     String
  catalogItemId String
  rank          Int
  matchScore    Float
  baseScore     Float
  strainMatch   Boolean  @default(false) // strain-specific product highlighted for this intent
  doseTierLabel String?
  doseUnitsText String?
  doseMgLow     Int?
  doseMgHigh    Int?
  reflection    String? // "why this matched" copy shown to the customer
  createdAt     DateTime @default(now())

  session     RecommendationSession @relation(fields: [sessionId], references: [id])
  catalogItem StoreProductCatalog   @relation(fields: [catalogItemId], references: [id])

  @@index([sessionId])
  @@index([catalogItemId, createdAt])
}

// Post-results email capture from the customer flow. Not an auth account —
// customer accounts require role-model work (admin auth grants partner_admin
// by default) and are deliberately deferred.
model MycoProfileSignup {
  id           String   @id @default(cuid())
  email        String
  sessionToken String?
  partnerId    String
  createdAt    DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([email])
  @@unique([partnerId, email, sessionToken])
}

// Shared store for unauthenticated public write rate limits. Counters must live
// outside Vercel Fluid instances so concurrent instances see the same bucket.
model PublicWriteRateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model RecommendationResult {
  id           String   @id @default(cuid())
  sessionId    String
  strainSlug   String
  rank         Int
  matchScore   Float
  baseScore    Float
  feedbackMod  Float    @default(0)
  adminMod     Float    @default(0)
  doseLevel    Int // 1-6 canonical level
  doseLowMg    Int
  doseHighMg   Int
  productUnits Int?
  cautionFlags String? // JSON string
  createdAt    DateTime @default(now())

  session  RecommendationSession   @relation(fields: [sessionId], references: [id])
  feedback RecommendationFeedback?

  @@index([sessionId])
  @@index([strainSlug, createdAt])
}

model RecommendationFeedback {
  id           String   @id @default(cuid())
  resultId     String   @unique
  quickRating  String // nailed_it, pretty_close, missed
  actualDoseMg Int?
  note         String?
  createdAt    DateTime @default(now())

  result  RecommendationResult   @relation(fields: [resultId], references: [id])
  signals RecommendationSignal[]

  @@index([quickRating])
}

model RecommendationSignal {
  id          String   @id @default(cuid())
  feedbackId  String
  dimensionId String // One of the 28 experiential dimensions
  direction   String // more, less, same
  createdAt   DateTime @default(now())

  feedback RecommendationFeedback @relation(fields: [feedbackId], references: [id])

  @@index([feedbackId])
  @@index([dimensionId])
}

model DosingGuideToken {
  id            String                 @id @default(cuid())
  token         String                 @unique
  sessionId     String?
  session       RecommendationSession? @relation(fields: [sessionId], references: [id])
  strainSlug    String
  partnerId     String
  retailerData  Json
  createdAt     DateTime               @default(now())
  downloadedAt  DateTime?
  downloadCount Int                    @default(0)
  metadata      Json?

  @@index([partnerId, createdAt])
  @@index([token])
  @@index([sessionId])
}

model StrainRecommendationConfig {
  id                      String   @id @default(cuid())
  strainSlug              String   @unique
  productName             String?
  productUrl              String?
  productUnitMg           Int?
  productFormat           String? // capsule, chocolate, gummy, dried
  availability            String   @default("in_stock") // in_stock, out_of_stock, seasonal
  doseSensitivityOverride      String? // null = use algorithm default
  intentOverrides              String? // JSON string: { "calm_centered": "boost", ... }
  cautionFlags                 String? // JSON string: { "show_sensitivity": true, "custom": "..." }
  productPackageMaterialMassMg Int?
  productUnitMaterialMassMg    Int?
  productMaterialMassBasis     String?
  productMaterialMassSource    String?
  productActiveCompound        String  @default("unknown")
  productActiveCompoundSource  String?
  updatedAt                    DateTime @updatedAt
  createdAt                    DateTime @default(now())

  @@index([availability])
}

model FeedbackAggregate {
  id             String   @id @default(cuid())
  strainSlug     String
  intentCategory String
  totalRatings   Int      @default(0)
  nailedIt       Int      @default(0)
  prettyClose    Int      @default(0)
  missed         Int      @default(0)
  feedbackMod    Float    @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([strainSlug, intentCategory])
  @@index([strainSlug])
}

model Partner {
  id                 String    @id @default(cuid())
  name               String
  subdomain          String?
  contactInfo        Json?
  mycoWelcomeMessage String?
  apiKeyHash         String    @unique
  allowedDomains     String // JSON array stored as string
  rateLimit          Int       @default(60)
  active             Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  lastActiveAt       DateTime?

  catalogItems StoreProductCatalog[]
  adminUsers   User[]
  employees    MycoEmployee[]
  reviewerEnrollmentEvents ReviewerEnrollmentEvent[]
  catalogAccessTokens CatalogAccessToken[]
  fieldVerificationRules CatalogFieldVerificationRule[]
  brandSubmissions BrandSubmission[]

  @@index([apiKeyHash])
  @@index([active])
}

// ============================================================================
// Myco — Conversation Engine
// ============================================================================

model MycoChatSession {
  id                      String   @id @default(cuid())
  recommendationSessionId String?  @unique
  partnerId               String
  sessionHash             String
  status                  String   @default("active") // active, completed, abandoned
  intentSummary           Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  recommendationSession RecommendationSession? @relation(fields: [recommendationSessionId], references: [id])
  messages              MycoMessage[]

  @@index([partnerId, createdAt])
  @@index([sessionHash])
}

model MycoMessage {
  id            String   @id @default(cuid())
  chatSessionId String
  role          String // user, assistant, system
  content       String
  intentSignals Json?
  createdAt     DateTime @default(now())

  chatSession MycoChatSession @relation(fields: [chatSessionId], references: [id])

  @@index([chatSessionId])
}

// ============================================================================
// Myco — Product Catalog
// ============================================================================

model StoreProductCatalog {
  id             String   @id @default(cuid())
  partnerId      String
  productName    String
  format         String // capsule, edible, dried, tincture, other
  sku            String?
  intakeStatus   String   @default("draft") // draft, in_review, ready
  brand          String? // legacy free-text (kept for back-compat)
  brandId        String? // FK to Brand (new)
  strainSlug     String? // legacy free-text (kept for back-compat)
  productUnitMg  Int? // mg of psilocybin per single unit
  unitsPerPack   Int? // # of units in the package
  totalDoseMg    Int? // computed total mg for the package
  ingredients    String[] // stacked ingredients/nootropics (Lion's Mane, Cordyceps, etc.)
  flavors        String[] // flavor variants sharing this recipe (Mint, Raspberry, Original)
  onsetMinutes   Int? // time-to-effect in minutes
  durationMinutes Int? // experience duration in minutes
  brandMicroUnits Int? // brand-recommended units for a microdose
  brandMiniUnits  Int? // brand-recommended units for a mini-dose
  brandMacroUnits Int? // brand-recommended units for a macro dose
  brandDoseTiers Json? // structured brand-facing dose tiers with fractions/ranges
  brandDoseInstructions String? // cadence, timing, food/stomach, and other brand guidance
  photoUrl              String? // legacy single photo (kept for back-compat)
  packageMaterialMassMg Int?
  unitMaterialMassMg    Int?
  materialMassBasis     String?
  materialMassSource    String?
  activeCompound        String   @default("unknown")
  activeCompoundSource  String?
  active                Boolean  @default(true)
  // --- KEWL-2335 listing gate ---
  // Research-only products (G23 Lady Hyphae isolated solution) must never enter the
  // customer path. Excluded outright rather than parked forever failing the gate.
  researchOnly          Boolean  @default(false)
  researchOnlyReason    String?
  // Jon-only force-list override. Never a silent boolean — the typed reason is
  // mandatory and is also written to the append-only CatalogFieldChange log.
  listingOverrideAt     DateTime?
  listingOverrideBy     String?
  listingOverrideReason String?
  archivedAt            DateTime?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  partner        Partner                @relation(fields: [partnerId], references: [id])
  brandRef       Brand?                 @relation(fields: [brandId], references: [id])
  photos         ProductPhoto[]
  vibeProfile    ProductVibeProfile?
  strengthOffset ProductStrengthOffset?
  outcomeReports UserOutcomeReport[]
  testerVotes    TesterVote[]
  employeeReviewAssignments MycoEmployeeReviewAssignment[]
  mycoResults    MycoRecommendationResult[]
  accessTokens   CatalogAccessToken[]
  catalogFieldChanges CatalogFieldChange[]
  fieldVerificationStates CatalogFieldVerificationState[]
  brandSubmissions BrandSubmission[]

  @@index([partnerId, active])
  @@index([strainSlug])
  @@index([brandId])
  @@index([partnerId, intakeStatus])
}

model Brand {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  logoUrl          String?
  artworkUrl       String?
  primaryColor     String?
  secondaryColor   String?
  accentColor      String?
  shortDescription String?
  websiteUrl       String?
  supportEmail     String?
  socialHandles    Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products StoreProductCatalog[]
  accessTokens CatalogAccessToken[]
  submissions BrandSubmission[]
}

model TesterVote {
  id              String   @id @default(cuid())
  catalogItemId   String
  voterName       String
  voterEmail      String
  voterPhone      String?
  relationship    String?  // staff, regular, friend, other
  // Effect sliders (0-100 each)
  clarityCognition Int?
  moodSocial       Int?
  visualPattern    Int?
  somatic          Int?
  energyDirection  Int?
  depthDirection   Int?
  // Onset / duration buckets
  onsetBucket    String?  // under_15, 15_30, 30_60, 60_plus
  durationBucket String?  // under_2, 2_4, 4_6, 6_plus
  // Dose taken
  unitsTaken     Float?
  // Which flavor variant the tester tried (optional; flavors share the recipe,
  // so this is a recipe-smell detector, not an effect dimension)
  flavor         String?
  // Free notes
  notes          String?
  // Metadata
  ipHash         String?
  userAgent      String?
  createdAt      DateTime @default(now())

  catalogItem StoreProductCatalog @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([catalogItemId, createdAt])
  @@index([voterEmail])
}

model ProductPhoto {
  id            String   @id @default(cuid())
  catalogItemId String
  url           String
  tag           String // stock, package_front, package_back, lifestyle, other
  flavor        String? // optional flavor variant this photo shows
  kind          String   @default("source") // source, transparent, white_background, derivative
  sourceUrl     String?
  isPrimary     Boolean  @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  status        String   @default("approved") // pending, approved, rejected
  submissionSource String @default("admin") // staff, brand, admin, import
  rejectedBy    String?
  rejectedAt    DateTime?
  rejectionReason String?
  brandSubmissionId String?
  provider      String?
  model         String?
  costCents     Int      @default(0)
  provenance    Json     @default("{}")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  catalogItem StoreProductCatalog @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  brandSubmission BrandSubmission? @relation(fields: [brandSubmissionId], references: [id], onDelete: SetNull)

  @@index([catalogItemId])
  @@index([catalogItemId, isPrimary])
  @@index([catalogItemId, status])
  @@index([brandSubmissionId])
}

model CatalogAccessToken {
  id                         String   @id @default(cuid())
  tokenHash                  String   @unique
  purpose                    String // staff_review, brand_portal
  status                     String   @default("active") // active, revoked, expired
  partnerId                  String
  brandId                    String?
  catalogItemId              String?
  issuedToType               String // staff, brand
  issuedToId                 String?
  issuedToEmail              String?
  issuedBy                   String?
  issuedAt                   DateTime @default(now())
  expiresAt                  DateTime?
  openedAt                   DateTime?
  revokedAt                  DateTime?
  revokedBy                  String?
  revocationReason           String?
  regeneratedFromId          String?
  // --- KEWL-2394 shared staff link: bounded self-enrollment window. ---
  // One shared `staff_review` link serves the whole roster, so an un-enrolled reviewer
  // picks their own name and sets a PIN on first use. That is only safe while the link
  // is fresh, so enrollment is time-boxed: `enrollmentClosesAt` is stamped at mint time
  // (now + 72h) and `enrollmentClosedAt` the moment the roster is fully enrolled or an
  // admin closes it early. Past either, an unclaimed reviewer fails closed until Jon
  // reopens the window through the admin control.
  enrollmentClosesAt         DateTime?
  enrollmentClosedAt         DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)
  catalogItem StoreProductCatalog? @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  employeeReviewAssignment MycoEmployeeReviewAssignment?
  regeneratedFrom CatalogAccessToken? @relation("CatalogTokenRegeneration", fields: [regeneratedFromId], references: [id], onDelete: SetNull)
  regenerations CatalogAccessToken[] @relation("CatalogTokenRegeneration")
  brandSubmissions BrandSubmission[]
  enrollmentEvents ReviewerEnrollmentEvent[]

  @@index([partnerId, purpose, status])
  @@index([brandId, status])
  @@index([catalogItemId, purpose])
  @@index([expiresAt])
}

model CatalogFieldChange {
  id             String   @id @default(cuid())
  catalogItemId  String
  fieldName      String
  previousValue  Json?
  submittedValue Json?
  actorType      String // staff, brand, admin, import
  actorIdentity  String
  source         String // packaging, brand-provided, personal-knowledge, unsure
  disposition    String @default("pending") // pending, accepted, rejected
  dispositionBy  String?
  dispositionAt  DateTime?
  dispositionReason String?
  brandSubmissionId String?
  createdAt      DateTime @default(now())

  catalogItem StoreProductCatalog @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  brandSubmission BrandSubmission? @relation(fields: [brandSubmissionId], references: [id], onDelete: SetNull)
  fieldStates CatalogFieldVerificationState[] @relation("LastAcceptedCatalogFieldChange")

  @@index([catalogItemId, fieldName, createdAt])
  @@index([catalogItemId, disposition])
  @@index([actorType, createdAt])
  @@index([brandSubmissionId])
}

model CatalogFieldVerificationState {
  id                    String   @id @default(cuid())
  catalogItemId         String
  fieldName             String
  state                 String   @default("unreviewed") // unreviewed, confirmed, disputed, unknown, needs_re_review
  requiredConfirmations Int      @default(1)
  confirmationsCount    Int      @default(0)
  confirmedValue        Json?
  lastAcceptedChangeId  String?
  reviewedAt            DateTime?
  updatedAt             DateTime @updatedAt

  catalogItem StoreProductCatalog @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  lastAcceptedChange CatalogFieldChange? @relation("LastAcceptedCatalogFieldChange", fields: [lastAcceptedChangeId], references: [id], onDelete: SetNull)

  @@unique([catalogItemId, fieldName])
  @@index([catalogItemId, state])
  @@index([fieldName, state])
}

model CatalogFieldVerificationRule {
  id                    String   @id @default(cuid())
  partnerId             String?
  fieldName             String
  requiredConfirmations Int      @default(1)
  active                Boolean  @default(true)
  // --- KEWL-2335: the approved required-field set lives here as CONFIG DATA. ---
  // KEWL-2033 renames the dose fields; when it lands we update rows, not code.
  tier                  String   @default("A") // A, B, C, D
  requiresDistinctReviewers Boolean @default(false) // Tier B: 2 different people
  gateRequired          Boolean  @default(true) // Tier D rows are false — excluded from the listing gate
  readinessKey          String? // maps to a computeReadiness() `missing[]` key, so Tier D exclusion is data
  catalogColumn         String? // StoreProductCatalog column this field writes to; null = log-only field.
  // ^ this is what makes the KEWL-2033 dose rename a row update instead of a code change.
  label                 String? // reviewer-facing field label
  helpText              String? // reviewer-facing hint
  inputType             String   @default("text") // text, number, list, strain, photo_check
  allowsConfirmedAbsent Boolean  @default(true) // "genuinely has no strain claim" satisfies the gate
  // Which confirmed answers actually satisfy the gate. Empty = any confirmed value does.
  // The photo check uses ["yes"], so a product confirmed to have the WRONG photo stays blocked.
  gateSatisfyingValues  String[] @default([])
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, fieldName])
  @@index([fieldName, active])
  @@index([tier, active])
}

model BrandSubmission {
  id                     String   @id @default(cuid())
  partnerId              String
  brandId                String
  catalogItemId          String?
  accessTokenId          String
  status                 String   @default("pending") // pending, accepted, rejected
  submitterName          String
  submitterRole          String
  contactPermission      Boolean  @default(false)
  preferredContactMethod String? // email, signal, telegram
  contactHandle          String?
  consentToContactAt     DateTime?
  imageUsageGrant        Boolean  @default(false)
  imageUsageGrantedAt    DateTime?
  imageUsageGrantedBy    String?
  payload                Json     @default("{}")
  createdAt              DateTime @default(now())
  reviewedAt             DateTime?
  reviewedBy             String?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  catalogItem StoreProductCatalog? @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  accessToken CatalogAccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Restrict)
  photos ProductPhoto[]
  fieldChanges CatalogFieldChange[]

  @@index([partnerId, createdAt])
  @@index([brandId, status])
  @@index([catalogItemId, status])
  @@index([accessTokenId])
}

model MycoEmployee {
  id        String   @id @default(cuid())
  partnerId String
  name      String
  email     String
  active    Boolean  @default(true)
  optedOut  Boolean  @default(false)
  points    Int      @default(0)
  streak    Int      @default(0)
  lastRespondedAt DateTime?
  // --- KEWL-2335 staff catalog review: first-use 4-digit PIN. ---
  // Deterrence-grade only (10,000 combinations), not security-grade. Slow-hashed
  // (scrypt) with a per-reviewer lockout so the small keyspace cannot be walked.
  pinHash           String?
  pinSetAt          DateTime?
  pinFailedAttempts Int      @default(0)
  pinLockedUntil    DateTime?
  pinLastUsedAt     DateTime?
  // KEWL-2394: reviewer sessions are stateless signed cookies, so resetting a PIN cannot
  // delete them. This is the revocation epoch — any session minted at or before this
  // instant is refused, which is what makes an admin PIN reset actually sign the device
  // out instead of merely changing the next PIN prompt.
  pinSessionsRevokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  assignments MycoEmployeeReviewAssignment[]
  enrollmentEvents ReviewerEnrollmentEvent[]

  @@unique([partnerId, email])
  @@index([partnerId, active])
}

/// KEWL-2394 — append-only enrollment ledger.
///
/// Every enrollment-state transition and every attempt at one lands here: a reviewer
/// claiming a name, a denial because the window had closed, an admin reopening the
/// window, a PIN reset. Nothing in the codebase updates or deletes a row — enrollment
/// state is never changed by a silent `UPDATE`, so "who claimed this name, when, and
/// under whose authority" is always answerable from the record itself.
model ReviewerEnrollmentEvent {
  id            String   @id @default(cuid())
  partnerId     String
  accessTokenId String?
  employeeId    String?
  /// Denormalised on purpose: the ledger has to stay readable after a reviewer row is
  /// renamed or removed, and `onDelete: SetNull` above would otherwise orphan the entry.
  employeeName  String?
  event         String // enrolled, enrollment_denied, pin_verified, pin_failed, pin_reset, pin_reset_all, window_reopened, window_auto_closed, link_minted
  outcome       String // allowed, denied
  actorType     String // reviewer, admin, system
  actorIdentity String
  reason        String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  partner     Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  accessToken CatalogAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)
  employee    MycoEmployee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@index([accessTokenId, createdAt])
  @@index([employeeId, createdAt])
}

model MycoEmployeeReviewAssignment {
  id            String   @id @default(cuid())
  catalogItemId String
  employeeId    String
  tokenHash     String   @unique
  accessTokenId String?  @unique
  status        String   @default("assigned") // assigned, opened, submitted, not_familiar, overdue, expired
  assignedBy    String?
  assignedAt    DateTime @default(now())
  openedAt      DateTime?
  submittedAt   DateTime?
  expiresAt     DateTime?
  reminderCount Int      @default(0)
  lastSentAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  catalogItem StoreProductCatalog @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  employee MycoEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accessToken CatalogAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)
  response MycoEmployeeProductReview?

  @@unique([catalogItemId, employeeId])
  @@index([catalogItemId, status])
  @@index([employeeId, status])
  @@index([expiresAt])
}

model MycoEmployeeProductReview {
  id            String   @id @default(cuid())
  assignmentId  String   @unique
  catalogItemId String
  employeeId    String
  knowsProduct   Boolean
  clarityCognition Int?
  moodSocial       Int?
  visualPattern    Int?
  somatic          Int?
  energyDirection  Int?
  depthDirection   Int?
  doseUnitsTried   Float?
  doseUnitLabel    String?
  onsetMinutes     Int?
  durationMinutes  Int?
  flavor           String?
  confidence       Int?
  familiarity      String?
  notes            String?
  pointsAwarded    Int      @default(0)
  userAgentHash    String?
  createdAt        DateTime @default(now())

  assignment MycoEmployeeReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([catalogItemId, createdAt])
  @@index([employeeId, createdAt])
}

// Durable ledger for the Tripdar product photo processing pipeline.
// Originals are immutable in Blob storage; sourceContentHash dedupes uploads by
// sha256(original bytes) so duplicate source images are not reprocessed.
model PhotoJob {
  id                 String                 @id @default(cuid())
  jobId              String                 @unique
  sku                String
  brand              String?
  productName        String
  variant            String?
  view               String
  sourceFile         String
  originalBlobUrl    String
  sourceContentHash  String                 @unique
  processingMode     PhotoJobProcessingMode @default(catalog_safe)
  status             PhotoJobStatus         @default(uploaded)
  qualityScore       Float?
  labelFidelityScore Float?
  warnings           Json                   @default("[]")
  manifest           Json                   @default("{}")
  costCents          Int                    @default(0)
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([sku])
  @@index([status, createdAt])
  @@index([processingMode, status])
}

model ProductVibeProfile {
  id            String   @id @default(cuid())
  catalogItemId String   @unique
  scores        Json // { focus: 0.8, sleep: 0.2, anxiety_relief: 0.5, ... }
  source        String   @default("admin") // admin, interview, flywheel
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  catalogItem StoreProductCatalog @relation(fields: [catalogItemId], references: [id])
}

model ProductStrengthOffset {
  id            String   @id @default(cuid())
  catalogItemId String   @unique
  offset        String   @default("standard") // standard, stronger, lighter
  rationale     String?
  confirmed     Boolean  @default(false) // Audrey/admin has reviewed and confirmed this offset
  confirmedAt   DateTime?
  confirmedBy   String? // email of the admin who confirmed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  catalogItem StoreProductCatalog @relation(fields: [catalogItemId], references: [id])
}

// ============================================================================
// Myco — Outcome Tracking
// ============================================================================

model UserOutcomeReport {
  id             String   @id @default(cuid())
  sessionHash    String
  catalogItemId  String?
  strainSlug     String?
  intendedEffect Json
  actualEffect   Json?
  rating         Int?
  notes          String?
  createdAt      DateTime @default(now())

  catalogItem StoreProductCatalog? @relation(fields: [catalogItemId], references: [id])

  @@index([sessionHash])
  @@index([catalogItemId])
  @@index([strainSlug])
}

