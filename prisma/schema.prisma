generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Note: SQLite does not support enums. Enum validation is enforced in application logic.
// Valid values are documented here for reference:
//
// DoseCategory: MICRODOSE, LOW, MODERATE, HIGH
// ExperienceScale: MICRO, MACRO
// ReferenceFrame: BASELINE, WITHIN_STRAIN, CROSS_STRAIN
// Direction: MORE, LESS, SAME, NOT_NOTICED

model Signal {
  // Immutability intent:
  // - Signals are append-only.
  // - Signals MUST NOT be updated or deleted (enforce in application logic; not encoded as schema constraints here).
  // - Aggregation is computed from signals and MUST NOT be stored on this table.

  id String @id // Unique identifier (provided by application; no helper defaults)

  // Context
  strainId      String
  doseCategory  String  // MICRODOSE, LOW, MODERATE, HIGH (validated in app)
  scale         String  // MICRO, MACRO (validated in app)

  // Dimension (must be one of the 28 experiential dimensions; enforced in application logic)
  dimensionId String

  // Reference + conditional comparison fields (enforce conditional rules in application logic)
  referenceFrame     String   // BASELINE, WITHIN_STRAIN, CROSS_STRAIN (validated in app)
  comparisonDose     String?  // REQUIRED ONLY when referenceFrame = WITHIN_STRAIN; MUST be null otherwise
  comparisonStrainId String?  // REQUIRED ONLY when referenceFrame = CROSS_STRAIN; MUST be null otherwise

  // Observation
  direction String  // MORE, LESS, SAME, NOT_NOTICED (validated in app)

  // Grouping / anonymity
  sessionId String // Anonymous session identifier
  reportId  String // Groups signals from one submission

  // Creation timestamp (set by application at insert-time; no additional timestamps are stored)
  createdAt DateTime
}

// ============================================================================
// Community Ratings & Reviews
// ============================================================================

model StrainRating {
  id          String   @id @default(cuid())
  strainSlug  String
  rating      Int      // 1-5 stars
  sessionHash String   // Anonymous session identifier
  partnerId   String   // Partner who facilitated this rating
  createdAt   DateTime @default(now())

  @@index([strainSlug])
  @@index([partnerId])
}

model StrainReview {
  id          String    @id @default(cuid())
  strainSlug  String
  rating      Int       // 1-5 stars
  title       String?
  body        String
  sessionHash String    // Anonymous session identifier
  partnerId   String    // Partner who facilitated this review
  status      String    @default("pending") // pending, approved, rejected
  createdAt   DateTime  @default(now())
  moderatedAt DateTime?
  moderatedBy String?

  @@index([strainSlug, status])
  @@index([partnerId])
  @@index([status])
}

// ============================================================================
// Trip Reports
// ============================================================================

model TripReport {
  id            String    @id @default(cuid())
  strainSlug    String
  sessionHash   String    // Anonymous session identifier
  partnerId     String    // Partner who facilitated this report

  // Dosing info
  doseAmount    String    // e.g., "2.5g", "1 stem"
  doseCategory  String    // MICRODOSE, LOW, MODERATE, HIGH, HEROIC

  // Experience context
  setting       String    // e.g., "nature", "home", "ceremony"
  intention     String?   // What they hoped to achieve

  // The report itself
  title         String
  body          String    // Full trip narrative
  duration      String?   // e.g., "4-6 hours"
  peakIntensity Int?      // 1-10 scale

  // Moderation
  status        String    @default("pending") // pending, approved, rejected
  createdAt     DateTime  @default(now())
  moderatedAt   DateTime?
  moderatedBy   String?

  @@index([strainSlug, status])
  @@index([partnerId])
  @@index([status])
}

// ============================================================================
// Analytics
// ============================================================================

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String   // page_view, quiz_complete, search, rating, report
  entitySlug  String?  // Strain slug or other entity reference
  partnerId   String   // Partner who generated this event
  sessionHash String   // Anonymous session identifier
  metadata    String?  // JSON string for additional event data
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([partnerId, createdAt])
  @@index([entitySlug, createdAt])
}

model AnalyticsSummary {
  id              String   @id @default(cuid())
  period          String   // daily, weekly, monthly
  periodStart     DateTime
  strainSlug      String?  // null for overall summary
  views           Int      @default(0)
  searches        Int      @default(0)
  quizCompletions Int      @default(0)
  ratings         Int      @default(0)
  reviews         Int      @default(0)
  reports         Int      @default(0)
  avgRating       Float?

  @@unique([period, periodStart, strainSlug])
  @@index([period, periodStart])
}
