// Myco — Lead Gen
// ============================================================================

model UnverifiedProduct {
  id               String   @id @default(cuid())
  sessionHash      String
  retailerName     String
  retailerLocation String?
  productName      String
  format           String?
  dosageInfo            String?
  photoUrls             Json?
  status                String   @default("pending") // pending, verified, rejected
  notes                 String?
  packageMaterialMassMg Int?
  unitMaterialMassMg    Int?
  materialMassBasis     String?
  materialMassSource    String?
  activeCompound        String   @default("unknown")
  activeCompoundSource  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  retailerLead RetailerLead?

  @@index([sessionHash])
  @@index([status])
}

model RetailerLead {
  id                  String   @id @default(cuid())
  unverifiedProductId String?  @unique
  retailerName        String
  retailerLocation    String?
  contactInfo         Json?
  status              String   @default("new") // new, contacted, qualified, converted, rejected
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sourceProduct UnverifiedProduct? @relation(fields: [unverifiedProductId], references: [id])

  @@index([status])
}

// ============================================================================
// NextAuth — Identity (required by @next-auth/prisma-adapter)
// ============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  partnerId     String?
  partner       Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  accounts      Account[]
  sessions      Session[]

  @@index([partnerId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
