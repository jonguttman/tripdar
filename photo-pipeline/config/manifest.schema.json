{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tripdar.local/photo-pipeline/manifest.schema.json",
  "title": "Tripdar Photo Pipeline Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "sku",
    "source_file",
    "processing_mode",
    "status",
    "outputs",
    "quality_score",
    "label_fidelity_score",
    "background_removal",
    "warnings",
    "approved_by",
    "approved_at"
  ],
  "properties": {
    "job_id": { "type": "string", "minLength": 1 },
    "sku": { "type": "string", "minLength": 1 },
    "source_file": { "type": "string", "minLength": 1 },
    "processing_mode": { "enum": ["catalog_safe", "premium"] },
    "status": {
      "enum": [
        "uploaded",
        "analyzing",
        "processing",
        "validating",
        "needs_review",
        "approved",
        "rejected",
        "failed"
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transparent_master", "white_master", "web", "thumbnail"],
      "properties": {
        "transparent_master": { "type": ["string", "null"] },
        "white_master": { "type": ["string", "null"] },
        "web": { "type": ["string", "null"] },
        "thumbnail": { "type": ["string", "null"] }
      }
    },
    "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "label_fidelity_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "background_removal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "model", "output_kind", "cost_usd", "usage"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "output_kind": { "enum": ["mask_or_cutout", "generative_image"] },
        "cost_usd": { "type": "number", "minimum": 0 },
        "usage": {}
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approved_by": { "type": ["string", "null"] },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "requires_review": { "type": "boolean" },
    "catalog_safe_outputs": { "$ref": "#/$defs/outputs" },
    "label_validation": {
      "type": "object",
      "required": ["score", "passed", "hardFlagged", "criticalDeltas", "issues", "signals", "regions"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed": { "type": "boolean" },
        "hardFlagged": { "type": "boolean" },
        "requiresReview": { "type": "boolean" },
        "criticalDeltas": { "type": "array", "items": { "type": "object" } },
        "issues": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "signals": { "type": "object" },
        "regions": { "type": "object" }
      }
    }
  },
  "$defs": {
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transparent_master", "white_master", "web", "thumbnail"],
      "properties": {
        "transparent_master": { "type": ["string", "null"] },
        "white_master": { "type": ["string", "null"] },
        "web": { "type": ["string", "null"] },
        "thumbnail": { "type": ["string", "null"] }
      }
    }
  }
}
